# Hébergement OVH mutualisé (Apache). Fichier servi à la racine de www/.
# Toutes les directives sont gardées par <IfModule> → aucune erreur 500 si un
# module manque.

# --- Canonisation d'URL (un seul saut de redirection quand c'est possible) ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) www.clairfisc.fr -> clairfisc.fr, directement en HTTPS (un seul 301).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2) Forcer HTTPS sur l'apex (pattern OVH : X-Forwarded-Proto, évite les boucles).
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3) /pfu-ou-bareme/ -> /faut-il-cocher-2op/ : les deux pages traitent la même
  #    question (PFU ou barème / case 2OP) avec le même simulateur, et se
  #    cannibalisaient sur les mêmes requêtes. La délégation de canonical (cf.
  #    src/lib/seo-canonical.ts) n'a pas suffi : au recrawl du 18/09/2026, Google a
  #    gardé /pfu-ou-bareme/ comme « URL canonique sélectionnée par Google : URL
  #    inspectée », ignorant le <link rel="canonical"> déclaré. La 301 ferme le
  #    sujet. Cible en dur sur l'apex https (jamais %{HTTP_HOST}, qui porterait
  #    encore « www » si cette règle passait avant la 1) : ainsi ce saut-ci reste
  #    unique une fois sur l'apex. Placée avant la règle de slash final (4) pour
  #    qu'une URL sans / final ne coûte pas un second saut.
  RewriteCond %{REQUEST_URI} ^/pfu-ou-bareme/?$
  RewriteRule ^ https://clairfisc.fr/faut-il-cocher-2op/ [L,R=301]

  # 4) Slash final géré par mod_rewrite plutôt que par mod_dir : ce dernier
  #    injecte un « :443 » disgracieux dans la redirection sur l'hébergement OVH.
  #    On désactive DirectorySlash et on ajoute le / nous-mêmes, avec le Host propre.
  DirectorySlash Off
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}/ [L,R=301]
</IfModule>

# --- Pas de listing de répertoire ---
# Sans index.html, Apache sert un « Index of / » indexable par Google
# (/declarer-compte/, /_astro/, /__ovh_icons/ répondaient 200 en HTML brut).
# Avec -Indexes ces URL renvoient 403 : plus de contenu parasite dans l'index.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# --- En-têtes de sécurité ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HSTS : à activer une fois le HTTPS confirmé stable en prod.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Cache : assets hashés immuables vs HTML revalidé ---
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
