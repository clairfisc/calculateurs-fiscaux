---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChecklistComptes from "../components/comptes-3916/ChecklistComptes.tsx";
import Disclaimer from "../components/content/Disclaimer.astro";
import { ETABLISSEMENTS } from "../lib/comptes-3916";

const title =
  "Quels comptes étrangers déclarer ? Checklist 3916 / 3916-bis (2026)";
const description =
  "Banque, néobanque, courtier, exchange crypto, PayPal : quels comptes étrangers devez-vous déclarer aux impôts (formulaire 3916 / 3916-bis) ? Checklist gratuite, verdict par compte et fiche à recopier. 100 % local, sans compte ni tracker.";
---

<BaseLayout title={title} description={description}>
    <main>
      <!-- Checklist : îlot React hydraté côté client -->
      <ChecklistComptes client:load />

      <!-- Contenu / SEO -->
      <section class="mx-auto w-full max-w-4xl px-4 pb-10">
        <Disclaimer />

        <article class="prose-clairfisc mt-6 text-sm text-slate-700">
          <h2 class="mb-2 text-base font-semibold text-slate-900">L'essentiel sur la déclaration des comptes étrangers</h2>
          <p>
            Depuis le 1<sup>er</sup> janvier 2019, tout résident fiscal français doit déclarer
            <strong>chaque compte ouvert, détenu, utilisé ou clos à l'étranger</strong> au cours de l'année — y
            compris un compte <strong>vide ou dormant</strong> (l'obligation porte sur l'existence du compte, pas
            sur son activité). Elle vise aussi le <strong>bénéficiaire d'une procuration</strong> sur un compte
            étranger, qui est en principe déclarant au même titre que le titulaire (BOFiP
            BOI-CF-CPF-30-20 §10 et §30) — nuance apportée par le §50 in fine : cette obligation ne
            vaut que si la procuration est utilisée pour des opérations réalisées pour son propre
            compte ou pour le compte d'un résident —,
            ainsi que les comptes détenus par le <strong>conjoint</strong> et par les <strong>personnes
            rattachées au foyer fiscal</strong> — le déclarant peut agir « pour le compte d'un membre de son
            foyer fiscal, d'une personne rattachée à ce foyer » (BOFiP BOI-CF-CPF-30-20 §50). Les
            <strong>portefeuilles de crypto-actifs</strong> (CGI art. 1649 bis C, terminologie en
            vigueur depuis le 01/07/2026 ; le cerfa 3916-bis millésime 2026 emploie encore le libellé
            « compte d'actifs numériques ») — Binance, Kraken, Coinbase… — relèvent du formulaire
            <strong>3916-bis</strong> et se déclarent même sans aucune opération.
          </p>
          <p class="mt-2">
            Une <strong>dispense</strong> existe pour les comptes de paiement / encaissement en ligne (type PayPal),
            à trois conditions cumulatives (BOFiP BOI-CF-CPF-30-20 §85) : le compte a pour objet de réaliser en
            ligne des paiements <strong>d'achats</strong> <em>ou</em> des encaissements afférents à des
            <strong>ventes de biens</strong> — la FAQ officielle précise qu'il doit servir <strong>uniquement</strong>
            à cet usage, ce qui exclut un compte de néobanque à usage général ; « l'ouverture du compte suppose la
            détention d'un autre compte ouvert en France et auquel il est adossé » (BOFiP §85) — une caractéristique
            du produit, pas un simple usage constaté, même si la FAQ officielle d'impots.gouv.fr retient une
            formulation plus souple (« lié à un autre compte que vous avez déjà ouvert en France ») ; et les
            encaissements annuels afférents à ces ventes de biens n'excèdent pas 10 000 €, seuil apprécié sur
            l'<strong>ensemble</strong> des comptes de même objet du titulaire, pas compte par compte — les
            <strong>prestations de services</strong> ne sont pas couvertes par la dispense et restent déclarables
            dès le premier euro encaissé.
          </p>
          <p class="mt-2 text-xs text-slate-500">
            Le BOFiP §85 vise les comptes détenus dans des « établissements financiers », sans jamais mentionner la
            monnaie électronique : étendre la dispense aux comptes de néobanque qui remplissent les trois
            conditions est donc une lecture, pas un fait établi par le texte. La FAQ officielle rappelle par
            ailleurs que « tous les autres comptes bancaires ouverts à l'étranger doivent être déclarés, même
            s'ils sont rattachés à un compte français, que vous en soyez le titulaire ou que vous ayez simplement
            une procuration ».
          </p>
          <p class="mt-2">
            Le défaut de déclaration est sanctionné pour chaque compte <strong>et</strong> pour chaque
            <strong>année non prescrite</strong> (BOI-CF-INF-20-10-50 §20) : <strong>1 500 €</strong> par compte
            bancaire (10 000 € pour un État sans convention d'assistance administrative), et, pour les
            portefeuilles de crypto-actifs (CGI art. 1736, X ; BOI-CF-INF-20-10-50 §87), <strong>750 €</strong>
            par portefeuille (125 € par omission ou inexactitude), dans la limite de 10 000 € par
            déclaration — montants
            <strong>doublés</strong> (1 500 € / 250 €) si la valeur vénale des comptes a dépassé 50 000 € à un
            moment quelconque de l'année. Un compte étranger omis expose en outre à un droit de reprise étendu à
            <strong>10 ans</strong> (LPF art. L. 169), sauf, pour les seuls comptes bancaires (CGI art.
            1649 A), si le contribuable prouve que le total des soldes créditeurs n'a jamais dépassé
            50 000 € à un moment quelconque de l'année — cette exception ne vise pas les portefeuilles
            de crypto-actifs. Un compte omis pendant 6 ans, c'est 6 × 1 500 €.
          </p>
          <p class="mt-2">
            Les <strong>contrats d'assurance-vie et de capitalisation</strong> souscrits hors de France se
            déclarent également, sur le <strong>cadre 7</strong> du formulaire (art. 1649 AA du CGI, sanction
            art. 1766) — un cas fréquent avec un contrat luxembourgeois ou irlandais.
          </p>
          <p class="mt-2 text-xs text-slate-500">
            Sources : CGI art. 1649 A, 1649 AA, 1649 bis C, 1736, 1766 ; LPF art. L. 169 ; BOFiP BOI-CF-CPF-30-20,
            BOI-CF-INF-20-10-50. Outil d'aide informative, ne remplace pas la doctrine officielle ni un conseil
            professionnel.
          </p>

          <nav class="mt-6" aria-label="Par établissement">
            <h2 class="mb-2 text-base font-semibold text-slate-900">
              <a class="underline" href="/declarer-compte/">Déclarer un compte par établissement</a>
            </h2>
            <ul class="flex flex-wrap gap-x-4 gap-y-1 text-blue-700">
              {ETABLISSEMENTS.map((e) => (
                <li>
                  <a class="underline" href={`/declarer-compte/${e.id}/`}>Compte {e.nomCourt ?? e.designation}</a>
                </li>
              ))}
            </ul>
          </nav>
        </article>
      </section>
    </main>
</BaseLayout>
