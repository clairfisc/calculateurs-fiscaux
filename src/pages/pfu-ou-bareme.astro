---
import BaseLayout from "../layouts/BaseLayout.astro";
import ComparateurPfuBareme from "../components/ComparateurPfuBareme.tsx";

// Positionnement : cette page vise le vocabulaire générique du régime (PFU, flat
// tax, barème progressif). La requête « case 2OP » et ses variantes sont traitées
// par /faut-il-cocher-2op/, qui porte la question décisionnelle et le même
// simulateur — les deux pages se cannibalisaient sur ce mot-clé.
const title = "Comparateur PFU (flat tax) ou barème progressif 2026 — gratuit";
const description =
  "Comparez gratuitement le PFU (flat tax : 30 %, 31,4 % en 2026) et le barème progressif sur vos dividendes, intérêts et plus-values de titres. Abattement de 40 %, CSG déductible, franchissement de tranche. Calcul 100 % local, open source, sans compte ni tracker.";
const repoUrl = "https://github.com/clairfisc/calculateurs-fiscaux";
---

<BaseLayout title={title} description={description}>
    <main>
      <!-- Comparateur : îlot React hydraté côté client -->
      <ComparateurPfuBareme client:load />

      <!-- Contenu / SEO -->
      <section class="mx-auto w-full max-w-4xl px-4 pb-10">
        <article class="prose prose-slate max-w-none text-sm leading-relaxed text-slate-700">
          {/*
            Page volontairement brève : elle délègue son canonical au guide
            /faut-il-cocher-2op/ (cf. src/lib/seo-canonical.ts), qui traite la même
            décision en profondeur. Y réexpliquer l'abattement, la CSG déductible ou
            la révocabilité ne ferait que dupliquer, en moins bien. On garde ici
            l'outil et le strict nécessaire pour s'en servir.
          */}
          <h2 class="text-base font-semibold text-slate-900">PFU ou barème : comment choisir ?</h2>
          <p>
            Vos revenus du capital (dividendes, intérêts, plus-values de cession de titres) sont
            imposés par défaut au <strong>prélèvement forfaitaire unique (PFU)</strong>, aussi
            appelé <em>flat tax</em> : <strong>12,8 % d'impôt sur le revenu + prélèvements
            sociaux</strong>, soit <strong>30 %</strong> au total, porté à <strong>31,4 %</strong>
            par la hausse de CSG de la LFSS 2026. Vous pouvez à la place opter pour le
            <strong>barème progressif</strong> : c'est intéressant quand votre tranche marginale
            (TMI) est faible. Le comparateur ci-dessus chiffre les deux régimes sur vos montants.
          </p>
          <p>
            <strong>Vous vous demandez s'il faut cocher la case 2OP ?</strong> C'est exactement la
            même décision, prise sous l'angle de la déclaration. Notre guide
            <a class="text-blue-700 underline" href="/faut-il-cocher-2op/"
              >faut-il cocher la case 2OP ?</a
            > y répond en détail — règle selon la TMI, abattement de 40 %, CSG déductible
            (<a class="text-blue-700 underline" href="/case-2bh-2cg/">case 2BH</a>), révocabilité de
            l'option depuis la loi de finances pour 2026 et que faire en cas d'oubli — avec ce même
            simulateur intégré.
          </p>
        </article>

        <aside class="mt-8 rounded-md border border-slate-200 border-l-4 border-l-amber-600 bg-amber-50/40 px-4 py-3 text-sm leading-relaxed text-slate-700">
          <p class="m-0">
            <strong>Aide informative, pas un conseil fiscal</strong> — ce comparateur estime l'impôt
            au barème à votre TMI et ne remplace pas le
            <a class="text-blue-700 underline" rel="noopener" target="_blank" href="https://www.service-public.gouv.fr/particuliers/vosdroits/F34913">simulateur officiel</a>
            ni un professionnel.
          </p>
          <p class="m-0 mt-3 text-slate-600">
            <strong>Open source (AGPLv3)</strong> — taux, règles et logique sont publics&nbsp;:
            <a class="text-blue-700 underline" rel="noopener" target="_blank" href={repoUrl}>voir le code</a>.
            Aucune donnée ne quitte votre navigateur ; zéro compte, zéro tracker.
          </p>
        </aside>

        <nav class="mt-6 text-sm" aria-label="Calculateurs">
          <h2 class="mb-2 text-base font-semibold text-slate-900">Autres calculateurs</h2>
          <ul class="list-inside list-disc text-blue-700">
            <li>
              <a class="underline" href="/dividendes-etrangers-2047/">Crédit d'impôt sur dividendes étrangers (2047, 8VL/8PL)</a>
            </li>
          </ul>
        </nav>
      </section>
    </main>
</BaseLayout>
