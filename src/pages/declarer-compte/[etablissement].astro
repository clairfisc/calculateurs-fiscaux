---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Disclaimer from "../../components/content/Disclaimer.astro";
import {
  ETABLISSEMENTS,
  evalueCompte,
  libelleVerdict,
  conduiteATenir,
  CLASSE_VERDICT,
  teneurHorsDeFrancePourType,
  descriptionFiche,
  type Etablissement,
} from "../../lib/comptes-3916";

/** Une page SEO par établissement (longue traîne « déclarer compte {X} impôts »). */
export function getStaticPaths() {
  return ETABLISSEMENTS.map((etab) => ({
    params: { etablissement: etab.id },
    props: { etab },
  }));
}

interface Props {
  etab: Etablissement;
}
const { etab } = Astro.props as Props;

// Verdict « par défaut » pour ce type d'établissement (réutilise le moteur → cohérence).
// Le lieu de tenue est repris de la base quand elle le sait de façon sourcée : sans lui,
// une fiche DEGIRO perdrait l'information portée par ses gabarits et retomberait à tort
// sur « selon votre situation ».
const lieuConnu = teneurHorsDeFrancePourType(etab, etab.typeParDefaut);
const r = evalueCompte({
  type: etab.typeParDefaut,
  etablissementId: etab.id,
  teneurHorsDeFrance: lieuConnu,
});
const estCrypto = etab.formulaireParDefaut === "3916-bis";
// Libellés centralisés (`lib/comptes-3916/libelles.ts`) : ils sont partagés avec le hub et
// la checklist, et doivent rester vrais pour CHAQUE fiche qui les emprunte. Le type de
// compte est transmis pour distinguer, sur le chemin `paiement_emoney`, le cas où le
// moteur n'a jamais établi le lieu de tenue (M5) : « conditions de dispense non remplies »
// plutôt qu'une affirmation sur le lieu que le moteur n'a pas vérifiée.
const verdictTexte = libelleVerdict(r.verdict, r.formulaire, etab.typeParDefaut);
const conduite = conduiteATenir(r.verdict);

// Nom d'usage pour title/H1/description (ex. « Trade Republic » plutôt que la raison
// sociale complète) ; le corps de la fiche continue d'afficher `designation`.
const nomAffiche = etab.nomCourt ?? etab.designation;

const title = `Déclarer son compte ${nomAffiche} aux impôts (3916${estCrypto ? " / 3916-bis" : ""}) — 2026`;
// Meta description : `descriptionSeo` explicite si défini, sinon un gabarit court dérivé
// du verdict par défaut (≤ 150 c. environ pour les noms les plus longs — l'ancien
// gabarit dépassait 160 caractères sur 9 fiches / 12, revue du 19/09/2026, I5).
// Fonction PARTAGÉE avec `etablissements.test.ts`, qui vérifie sa longueur sur les 12
// fiches : un changement de gabarit ici doit faire échouer CE test, pas lui échapper.
const description = descriptionFiche(etab, r);
const lienOutil = "/comptes-etrangers-3916/";
---

<BaseLayout title={title} description={description} ogType="article">
    <main class="mx-auto w-full max-w-3xl px-4 py-8">
      <article class="flex flex-col gap-4 text-slate-700">
        <header>
          <h1 class="text-2xl font-bold text-slate-900">
            Faut-il déclarer votre compte {nomAffiche} aux impôts&nbsp;?
          </h1>
          <p class="mt-1 text-sm text-slate-500">
            {/* Quand le lieu de tenue n'est pas le même pour tous les clients (`lieuConnu`
                indéterminé), `pays` ne désigne que l'entité D'ORIGINE : l'afficher en
                « Établissement situé » contredirait visuellement une fiche dont la réponse
                différenciante est justement « ça dépend de votre succursale » (M2). */}
            {etab.pays
              ? lieuConnu === undefined
                ? `Entité d'origine : ${etab.pays}. `
                : `Établissement situé : ${etab.pays}. `
              : ""}Formulaire {etab.formulaireParDefaut}
            {estCrypto ? " (comptes d'actifs numériques)" : ""}.
          </p>
        </header>

        {/* Couleur pilotée par le verdict : un encadré ambre « attention » sur une réponse
            « hors champ » contredisait visuellement le texte qu'il portait. */}
        <p class={`rounded-md border px-3 py-2 ${CLASSE_VERDICT[r.verdict]}`}>
          <strong>{verdictTexte}.</strong> {r.motif}
        </p>

        {etab.sections?.map((section) => (
          <>
            <h2 class="mt-2 text-lg font-semibold text-slate-900">{section.titre}</h2>
            <p>{section.corps}</p>
          </>
        ))}

        {etab.note && <p class="rounded-md bg-slate-100 px-3 py-2 text-sm italic">{etab.note}</p>}

        {estCrypto && etab.codePsan && (
          <p>
            Sur le formulaire <strong>3916-bis</strong>, {etab.designation} correspond au code PSAN
            <strong> {etab.codePsan}</strong> (liste officielle des plateformes).
          </p>
        )}

        <h2 class="mt-2 text-lg font-semibold text-slate-900">Le principe</h2>
        <p>
          Depuis 2019, un résident fiscal français doit déclarer <strong>tout compte ouvert, détenu, utilisé ou
          clos à l'étranger</strong> au cours de l'année — même <strong>vide ou dormant</strong>. L'obligation
          porte sur l'existence du compte, pas sur son activité. {estCrypto
            ? "Un compte d'actifs numériques se déclare même sans aucune cession."
            : "Cela vaut aussi pour les néobanques et comptes-titres tenus à l'étranger."}
        </p>

        <h2 class="mt-2 text-lg font-semibold text-slate-900">Les sanctions</h2>
        <p>
          Le défaut de déclaration coûte <strong>1 500 €</strong> par compte bancaire (10 000 € pour un État sans
          convention d'assistance) et <strong>750 €</strong> par compte d'actifs numériques&nbsp;: déclarer est
          bien moins coûteux que l'oubli.
        </p>

        <div class="mt-3 rounded-lg border border-blue-200 bg-blue-50 p-4">
          <p class="font-medium text-slate-900">Vérifiez tous vos comptes et obtenez la fiche à recopier</p>
          <p class="mt-1 text-sm">
            Notre checklist gratuite indique, pour chacun de vos comptes, s'il est à déclarer et sur quel
            formulaire, puis génère la fiche à recopier sur impots.gouv.
          </p>
          <a
            href={lienOutil}
            class="mt-3 inline-block rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700"
          >
            Ouvrir la checklist comptes étrangers →
          </a>
        </div>

        {/* Conduite à tenir : dire ce qu'il faut FAIRE, et à quel coût. L'ancienne phrase
            « rapprochez-vous de la doctrine ou d'un professionnel » renvoyait le lecteur
            vers une consultation payante là où l'asymétrie de sanction suffit à décider. */}
        {conduite && <p class="rounded-md bg-slate-100 px-3 py-2 text-sm">{conduite}</p>}

        <p class="text-xs text-slate-500">
          Source du verdict&nbsp;: {r.source}. Outil d'aide informative, ne remplace pas la doctrine officielle ni
          un conseil professionnel.
        </p>

        <Disclaimer />
      </article>
    </main>
</BaseLayout>
